{
  "id": "com.anker.solix",
  "version": "1.1.1",
  "compatibility": ">=12.13.0",
  "sdk": 3,
  "platforms": ["local", "cloud"],
  "brandColor": "#0066CC",
  "name": { "en": "Anker Solix", "nl": "Anker Solix" },
  "description": {
    "en": "Monitor and control your Anker Solix solar energy system",
    "nl": "Bewaak en beheer uw Anker Solix zonne-energiesysteem"
  },
  "tags": {
    "en": ["solar", "battery", "energy", "anker", "solix", "solarbank"],
    "nl": ["zonne-energie", "batterij", "energie", "anker", "solix", "solarbank"]
  },
  "category": ["energy"],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jeroen Reijling",
    "email": "jeroen@reijling.nl"
  },
  "bugs": {
    "url": "https://github.com/Jreijling/Homey/issues"
  },
  "source": "https://github.com/Jreijling/Homey/tree/main/com.anker.solix",
  "homepage": "https://github.com/Jreijling/Homey/tree/main/com.anker.solix#readme",
  "capabilities": {
    "solar_power": {
      "type": "number",
      "title": { "en": "Solar Power", "nl": "Zonnestroom" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 20000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/solar_power.svg"
    },
    "battery_charge_power": {
      "type": "number",
      "title": { "en": "Battery Charge Power", "nl": "Batterij oplaadvermogen" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 10000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/battery_charge_power.svg"
    },
    "battery_discharge_power": {
      "type": "number",
      "title": { "en": "Battery Discharge Power", "nl": "Batterij ontlaadvermogen" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 10000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/battery_discharge_power.svg"
    },
    "ac_output_power": {
      "type": "number",
      "title": { "en": "AC Output Power", "nl": "AC uitgangsvermogen" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 10000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/ac_output_power.svg"
    },
    "grid_charge_power": {
      "type": "number",
      "title": { "en": "Grid Charge Power", "nl": "Netlaadvermogen" },
      "units": "W",
      "getable": true,
      "setable": true,
      "insights": true,
      "min": 0,
      "max": 3500,
      "step": 50,
      "decimals": 0,
      "uiComponent": "slider",
      "icon": "/assets/capabilities/battery_charge_power.svg"
    },
    "grid_export_limit": {
      "type": "number",
      "title": { "en": "Max Grid Export Power", "nl": "Maximaal vermogen naar het net" },
      "units": "W",
      "getable": true,
      "setable": true,
      "insights": false,
      "min": 0,
      "max": 3500,
      "step": 100,
      "decimals": 0,
      "uiComponent": "slider",
      "icon": "/assets/capabilities/grid_export_power.svg"
    },
    "ac_input_limit": {
      "type": "number",
      "title": { "en": "Max AC Input Power", "nl": "Maximaal invoervermogen" },
      "units": "W",
      "getable": true,
      "setable": true,
      "insights": false,
      "min": 0,
      "max": 3500,
      "step": 100,
      "decimals": 0,
      "uiComponent": "slider",
      "icon": "/assets/capabilities/ac_output_power.svg"
    },
    "output_preset_power": {
      "type": "number",
      "title": { "en": "Output Power Target", "nl": "Uitgangsvermogen doel" },
      "units": "W",
      "getable": true,
      "setable": true,
      "insights": false,
      "min": 0,
      "max": 1800,
      "step": 10,
      "decimals": 0,
      "uiComponent": "slider",
      "icon": "/assets/capabilities/output_preset_power.svg"
    },
    "battery_min_soc": {
      "type": "number",
      "title": { "en": "Min Battery SOC", "nl": "Min. batterijlading" },
      "units": "%",
      "getable": true,
      "setable": true,
      "insights": false,
      "min": 0,
      "max": 100,
      "step": 5,
      "decimals": 0,
      "uiComponent": "slider",
      "icon": "/assets/capabilities/battery_min_soc.svg"
    },
    "grid_export_enabled": {
      "type": "boolean",
      "title": { "en": "Grid Export", "nl": "Netexport" },
      "getable": true,
      "setable": true,
      "insights": false,
      "uiComponent": "toggle",
      "icon": "/assets/capabilities/grid_export_enabled.svg"
    },
    "battery_hold": {
      "type": "boolean",
      "title": { "en": "Hold Battery (0W)", "nl": "Accu vasthouden (0W)" },
      "getable": true,
      "setable": true,
      "insights": false,
      "uiComponent": "toggle",
      "icon": "/assets/capabilities/grid_export_enabled.svg"
    },
    "home_load_power": {
      "type": "number",
      "title": { "en": "Home Load", "nl": "Thuisverbruik" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 50000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/home_load_power.svg"
    },
    "grid_import_power": {
      "type": "number",
      "title": { "en": "Grid Import Power", "nl": "Nettimportvermogen" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 50000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/grid_import_power.svg"
    },
    "grid_export_power": {
      "type": "number",
      "title": { "en": "Grid Export Power", "nl": "Netexportvermogen" },
      "units": "W",
      "getable": true,
      "setable": false,
      "insights": true,
      "min": 0,
      "max": 50000,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/grid_export_power.svg"
    }
  },
  "drivers": [
    {
      "id": "solarbank",
      "name": { "en": "Solarbank", "nl": "Solarbank" },
      "class": "battery",
      "platforms": ["local", "cloud"],
      "capabilities": [
        "measure_battery",
        "measure_power",
        "meter_power.charged",
        "meter_power.discharged",
        "solar_power",
        "battery_charge_power",
        "battery_discharge_power",
        "ac_output_power",
        "grid_charge_power",
        "grid_export_limit",
        "ac_input_limit",
        "output_preset_power",
        "battery_min_soc",
        "grid_export_enabled",
        "battery_hold",
        "target_power",
        "target_power_mode"
      ],
      "capabilitiesOptions": {
        "measure_battery": {
          "title": { "en": "Battery SOC", "nl": "Batterijlading" }
        },
        "measure_power": {
          "title": { "en": "Battery Power", "nl": "Batterijvermogen" }
        },
        "meter_power.charged": {
          "title": { "en": "Total Charged", "nl": "Totaal geladen" }
        },
        "meter_power.discharged": {
          "title": { "en": "Total Discharged", "nl": "Totaal ontladen" }
        },
        "target_power": {
          "min": -3500,
          "max": 3500,
          "step": 10
        }
      },
      "settings": [
        {
          "id": "target_power_timeout",
          "type": "number",
          "label": { "en": "Target power failsafe (minutes)", "nl": "Doelvermogen failsafe (minuten)" },
          "hint": {
            "en": "When no new target power command arrives (e.g. from an EMS) within this time, the battery returns to its own self-consumption mode. 0 = disabled (default). Leave at 0 for an EMS that only sends a command when the setpoint changes, such as Ultimate EMS: otherwise the battery drops out of EMS control during a long steady setpoint.",
            "nl": "Als er binnen deze tijd geen nieuw doelvermogen-commando binnenkomt (bijv. van een EMS), gaat de accu terug naar zijn eigen zelfconsumptiemodus. 0 = uit (standaard). Laat op 0 staan bij een EMS die alleen een commando stuurt als het setpoint verandert, zoals Ultimate EMS: anders valt de accu tijdens een lang gelijk setpoint uit de EMS-aansturing."
          },
          "value": 0,
          "min": 0,
          "max": 1440,
          "units": { "en": "min" }
        }
      ],
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.charged",
        "meterPowerExportedCapability": "meter_power.discharged"
      },
      "images": {
        "small": "/drivers/solarbank/assets/images/small.png",
        "large": "/drivers/solarbank/assets/images/large.png",
        "xlarge": "/drivers/solarbank/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "smart-meter",
      "name": { "en": "Smart Meter", "nl": "Slimme meter" },
      "class": "sensor",
      "platforms": ["local", "cloud"],
      "capabilities": [
        "measure_power",
        "grid_import_power",
        "grid_export_power",
        "meter_power.imported",
        "meter_power.exported",
        "meter_power.imported_today",
        "meter_power.exported_today"
      ],
      "capabilitiesOptions": {
        "measure_power":              { "title": { "en": "Net Grid Power", "nl": "Netto netvermogen" } },
        "meter_power.imported":       { "title": { "en": "Total Imported", "nl": "Totaal afgenomen" } },
        "meter_power.exported":       { "title": { "en": "Total Exported", "nl": "Totaal teruggeleverd" } },
        "meter_power.imported_today": { "title": { "en": "Imported Today", "nl": "Vandaag afgenomen" } },
        "meter_power.exported_today": { "title": { "en": "Exported Today", "nl": "Vandaag teruggeleverd" } }
      },
      "energy": {
        "cumulative": true,
        "cumulativeImportedCapability": "meter_power.imported",
        "cumulativeExportedCapability": "meter_power.exported"
      },
      "images": {
        "small": "/drivers/smart-meter/assets/images/small.png",
        "large": "/drivers/smart-meter/assets/images/large.png",
        "xlarge": "/drivers/smart-meter/assets/images/xlarge.png"
      },
      "settings": [
        {
          "id": "main_meter",
          "type": "checkbox",
          "value": true,
          "label": { "en": "Use as main meter in Homey Energy", "nl": "Gebruik als hoofdmeter in Homey Energie" },
          "hint": {
            "en": "Reports cumulative grid import/export to Homey Energy, like a HomeWizard or Pulse P1 meter. Disable when another P1 meter already fills this role, to avoid double counting.",
            "nl": "Meldt cumulatieve netafname/-teruglevering aan Homey Energie, zoals een HomeWizard- of Pulse P1-meter. Zet uit als een andere P1-meter deze rol al heeft, om dubbeltelling te voorkomen."
          }
        }
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "system",
      "name": { "en": "Power System", "nl": "Energiesysteem" },
      "class": "other",
      "platforms": ["local", "cloud"],
      "capabilities": [
        "solar_power",
        "home_load_power",
        "measure_power",
        "measure_battery",
        "grid_import_power",
        "grid_export_power",
        "meter_power.generated"
      ],
      "capabilitiesOptions": {
        "measure_battery": {
          "title": { "en": "Average Battery SOC", "nl": "Gem. batterijlading" }
        },
        "measure_power": {
          "title": { "en": "Net Grid Power", "nl": "Netto netvermogen" }
        }
      },
      "energy": {
        "batteries": ["INTERNAL"]
      },
      "images": {
        "small": "/drivers/system/assets/images/small.png",
        "large": "/drivers/system/assets/images/large.png",
        "xlarge": "/drivers/system/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "solarbank_charging_started",
        "title": { "en": "Battery started charging", "nl": "Batterij is begonnen met opladen" },
        "args": [{ "name": "device", "type": "device", "filter": "driver_id=solarbank" }]
      },
      {
        "id": "solarbank_charging_stopped",
        "title": { "en": "Battery stopped charging", "nl": "Batterij is gestopt met opladen" },
        "args": [{ "name": "device", "type": "device", "filter": "driver_id=solarbank" }]
      },
      {
        "id": "solarbank_discharging_started",
        "title": { "en": "Battery started discharging", "nl": "Batterij is begonnen met ontladen" },
        "args": [{ "name": "device", "type": "device", "filter": "driver_id=solarbank" }]
      },
      {
        "id": "grid_import_started",
        "title": { "en": "Grid import started", "nl": "Nettimport gestart" },
        "args": [{ "name": "device", "type": "device", "filter": "driver_id=smart-meter" }]
      },
      {
        "id": "grid_export_started",
        "title": { "en": "Grid export started", "nl": "Netexport gestart" },
        "args": [{ "name": "device", "type": "device", "filter": "driver_id=smart-meter" }]
      }
    ],
    "conditions": [
      {
        "id": "battery_soc_above",
        "title": { "en": "Battery SOC !{{is|is not}} above {{soc}}%", "nl": "Batterijlading !{{is|is niet}} boven {{soc}}%" },
        "titleFormatted": { "en": "Battery SOC !{{is|is not}} above [[soc]]%", "nl": "Batterijlading !{{is|is niet}} boven [[soc]]%" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=solarbank" },
          { "name": "soc", "type": "number", "min": 0, "max": 100, "step": 5, "placeholder": { "en": "50", "nl": "50" } }
        ]
      },
      {
        "id": "solar_power_above",
        "title": { "en": "Solar power !{{is|is not}} above {{watts}}W", "nl": "Zonnestroom !{{is|is niet}} boven {{watts}}W" },
        "titleFormatted": { "en": "Solar power !{{is|is not}} above [[watts]]W", "nl": "Zonnestroom !{{is|is niet}} boven [[watts]]W" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=solarbank|driver_id=system" },
          { "name": "watts", "type": "number", "min": 0, "max": 20000, "step": 10, "placeholder": { "en": "500", "nl": "500" } }
        ]
      },
      {
        "id": "grid_importing",
        "title": { "en": "Grid !{{is|is not}} importing power", "nl": "Net !{{importeert|importeert niet}} stroom" },
        "args": [{ "name": "device", "type": "device", "filter": "driver_id=smart-meter|driver_id=system" }]
      }
    ],
    "actions": [
      {
        "id": "set_output_preset",
        "title": { "en": "Set output power target", "nl": "Stel uitgangsvermogen in" },
        "titleFormatted": { "en": "Set output power target to [[watts]]W", "nl": "Stel uitgangsvermogen in op [[watts]]W" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=solarbank" },
          { "name": "watts", "type": "number", "min": 0, "max": 1800, "step": 10, "placeholder": { "en": "100", "nl": "100" } }
        ]
      },
      {
        "id": "set_grid_export",
        "title": { "en": "Set grid export", "nl": "Stel netexport in" },
        "titleFormatted": { "en": "Set grid export to [[enabled]]", "nl": "Stel netexport in op [[enabled]]" },
        "args": [
          { "name": "device", "type": "device", "filter": "driver_id=solarbank" },
          { "name": "enabled", "type": "dropdown", "values": [
            { "id": "true", "label": { "en": "Enabled", "nl": "Ingeschakeld" } },
            { "id": "false", "label": { "en": "Disabled", "nl": "Uitgeschakeld" } }
          ]}
        ]
      }
    ]
  }
}
